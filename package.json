{
  "name": "job-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/legacy/db/seed.ts",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "db:check": "drizzle-kit check",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "ai:smoke": "tsx --conditions=react-server --env-file=.env.local scripts/ai-smoke.ts",
    "format": "prettier --write src/server src/lib src/app/api/cron/drain tests/unit tests/integration tests/stubs scripts *.config.ts tsconfig.strict.json",
    "format:check": "prettier --check src/server src/lib src/app/api/cron/drain tests/unit tests/integration tests/stubs scripts *.config.ts tsconfig.strict.json"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "groq-sdk": "^1.6.0",
    "html-to-text": "^10.0.1",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.52.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
