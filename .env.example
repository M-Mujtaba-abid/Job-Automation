# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require   # pooled, used by app
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require # direct, used by drizzle-kit

# --- App / Auth ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # production URL on Vercel (Apify webhooks call it)
APP_PASSWORD=choose-a-strong-password
AUTH_SECRET=                                # 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=                                # 32+ random chars, protects /api/cron/* (v1 also uses it for /api/webhooks/apify; v2 uses WEBHOOK_SECRET_APIFY)

# --- Job source: Apify (required) ---
APIFY_TOKEN=                                # apify.com → Settings → API & Integrations
APIFY_LINKEDIN_ACTOR_ID=harvestapi~linkedin-post-search   # seed default (no cookies needed)
APIFY_FACEBOOK_ACTOR_ID=apify~facebook-groups-scraper     # seed default (public groups)

# --- Default search config ---
DEFAULT_KEYWORDS=react developer,next.js developer,frontend developer
DEFAULT_LOCATION=Pakistan
DEFAULT_COUNTRY_CODE=92                     # used to normalize local phone numbers

# --- Email sending (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=gmail-app-password                # Google Account → Security → App passwords
MAIL_FROM="Your Name <you@gmail.com>"
MAIL_DELAY_MS=4000                          # gap between sends to avoid spam flags
MAIL_DAILY_LIMIT=150

# --- Fetch tuning ---
FETCH_MIN_INTERVAL_HOURS=6                  # don't re-run a source more often than this


# =====================================================================
# v2 (PLANNED: not read by any code yet; introduced per milestone).
# ACTIVE PROFILE: ZERO-COST (plan/TECHNICAL_DECISIONS.md ADR-023). Names only, no values.
# =====================================================================
# --- Background jobs (M0): /api/cron/drain is called by cron-job.org with Bearer CRON_SECRET ---
# DRAIN_TIME_BUDGET_MS=20000             # cron-job.org times out at 30 s
# --- Auth (M1, Better Auth, Google sign-in only) ---
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000     # production: https://<your-app>.vercel.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# --- AI (M2/M4): free tiers ---
# LLM_PRIMARY_PROVIDER=gemini
# LLM_FALLBACK_PROVIDER=groq
# GEMINI_API_KEY=                   # Google AI Studio (free tier)
# GROQ_API_KEY=                     # console.groq.com (free tier)
# LLM_MODEL_RESUME_EXTRACT=         # choose from the provider's current free-tier model list
# LLM_MODEL_JOB_EXTRACT=
# LLM_MODEL_MATCH_EXPLAIN=
# LLM_MODEL_FALLBACK=
# LLM_DAILY_BUDGET_GEMINI=          # requests/day, set below the published free limit
# LLM_DAILY_BUDGET_GROQ=
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=
# EMBEDDING_DIM=768
# --- Gmail API (M8, OAuth app in Testing mode) ---
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# ENCRYPTION_MASTER_KEY_V1=         # 32 random bytes, base64
# --- Webhooks (legacy Apify, owner only) ---
# WEBHOOK_SECRET_APIFY=
# --- Observability (M0, Sentry free plan) ---
# SENTRY_DSN=
# LOG_LEVEL=info
# --- Local automation runner (M9, owner PC only; least-privilege DB role) ---
# AUTOMATION_RUNNER_DATABASE_URL=
